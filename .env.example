# Entorno de ejecución
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# "real" usa PostgreSQL y el reloj del sistema.
# "fake" usa adaptadores en memoria y un reloj fijo (útil sin base de datos).
ADAPTERS_MODE=real

# Base de datos PostgreSQL (obligatoria en modo real)
DATABASE_URL=postgresql://admin:password@localhost:5432/proy_db
DATABASE_SSL=false
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=5000

# HTTP
CORS_ORIGIN=*
BODY_LIMIT=100kb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
