# Entorno de ejecución
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# "real" usa PostgreSQL y el reloj del sistema.
# "fake" usa adaptadores en memoria y un reloj fijo (útil sin base de datos).
ADAPTERS_MODE=real

# Base de datos PostgreSQL (obligatoria en modo real)
DATABASE_URL=postgresql://admin:password@localhost:5432/proy_db
DATABASE_SSL=false
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=5000

# Docker Compose: credenciales del contenedor PostgreSQL y puertos publicados
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
POSTGRES_DB=proy_db
POSTGRES_PORT=5432
APP_PORT=3000

# PostgreSQL efímero para tests de integración reales (compose.test.yaml).
# El runner `pnpm test:integration:db` lo levanta, migra y lo baja solo.
POSTGRES_TEST_PORT=5433
# TEST_DATABASE_URL=postgresql://admin:password@127.0.0.1:5433/proy_db_test

# Autenticación (JWT_SECRET es obligatorio en modo real; mínimo 32 caracteres)
JWT_SECRET=cambiar-este-secreto-de-desarrollo-de-al-menos-32-caracteres
JWT_EXPIRES_IN_MINUTES=60
PASSWORD_HASH_COST=12
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=5

# Viajes: tarifa provisional expresada en centavos.
# El cliente nunca envía importes; el servidor calcula el precio.
TARIFA_BASE_CENTAVOS=100000
TARIFA_POR_KM_CENTAVOS=50000
TARIFA_MINIMO_CENTAVOS=150000
TARIFA_MAXIMO_CENTAVOS=1000000
IDEMPOTENCIA_TTL_MS=86400000

# Ciclo de vida y disponibilidad
READINESS_TIMEOUT_MS=3000
SHUTDOWN_TIMEOUT_MS=10000

# HTTP
CORS_ORIGIN=*
BODY_LIMIT=100kb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
